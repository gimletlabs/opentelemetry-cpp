package(default_visibility = ["//visibility:public"])

gml_prefix = "@gml//third_party/github.com/open-telemetry/opentelemetry-proto/opentelemetry/proto/"

alias(
    name = "common_proto_cc",
    actual = gml_prefix + "common/v1:v1_cc_library",
)

alias(
    name = "resource_proto_cc",
    actual = gml_prefix + "resource/v1:v1_cc_library",
)

alias(
    name = "trace_proto_cc",
    actual = gml_prefix + "trace/v1:v1_cc_library",
)

alias(
    name = "trace_service_proto_cc",
    actual = gml_prefix + "collector/trace/v1:v1_cc_library",
)

alias(
    name = "trace_service_grpc_cc",
    actual = gml_prefix + "collector/trace/v1:v1_grpc_cc_library",
)

alias(
    name = "logs_proto_cc",
    actual = gml_prefix + "logs/v1:v1_proto_library",
)

alias(
    name = "logs_service_proto_cc",
    actual = gml_prefix + "collector/logs/v1:v1_cc_library",
)

alias(
    name = "logs_service_grpc_cc",
    actual = gml_prefix + "collector/logs/v1:v1_grpc_cc_library",
)

alias(
    name = "metrics_proto_cc",
    actual = gml_prefix + "metrics/v1:v1_cc_library",
)

alias(
    name = "metrics_service_proto_cc",
    actual = gml_prefix + "collector/metrics/v1:v1_cc_library",
)

alias(
    name = "metrics_service_grpc_cc",
    actual = gml_prefix + "collector/metrics/v1:v1_grpc_cc_library",
)
